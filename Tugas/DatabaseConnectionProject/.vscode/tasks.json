{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "java: build",
            "type": "shell",
            "command": "javac",
            "args": [
                "--release",
                "17",
                "-cp",
                "mysql-connector-j-9.5.0/mysql-connector-j-9.5.0.jar",
                "-d",
                "bin",
                "src/main.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "java: run",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "bin;mysql-connector-j-9.5.0/mysql-connector-j-9.5.0.jar",
                "main"
            ],
            "dependsOn": ["java: build"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "java: run (batch)",
            "type": "shell",
            "command": ".\\run.bat",
            "group": {
                "kind": "test"
            },
            "isBackground": false
        },
        {
            "label": "java: run (PowerShell)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "run.ps1"
            ],
            "group": {
                "kind": "test"
            },
            "isBackground": false,
            "presentation": {
                "echo": true,
                "reveal": "always"
            }
        }
    ]
}
