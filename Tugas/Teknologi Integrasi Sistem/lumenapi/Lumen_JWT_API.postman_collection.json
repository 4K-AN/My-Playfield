{
  "info": {
    "_postman_id": "lumen-jwt-api",
    "name": "Lumen JWT API Documentation",
    "description": "Koleksi lengkap untuk testing JWT Authentication di Lumen API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth Endpoints",
      "item": [
        {
          "name": "Register - Berhasil",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Mahasiswa Baru\",\n    \"email\": \"maba@student.ub.ac.id\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register - Email Duplikat (Gagal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Duplicate User\",\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "register"]
            }
          },
          "response": []
